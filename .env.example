# Copy values into a private .env or your hosting platform settings.
# For a NEW local setup, `node scripts/init-backend.cjs` generates distinct secrets.
NODE_ENV=development
POSTGRES_DB=strobot
POSTGRES_USER=strobot
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
MAIL_PROVIDER=file
MAIL_OUTBOX=/app/.mail-outbox
# Production email registration requires explicit HTTPS frontend origin and SMTP.
# For internal school accounts, use all three together:
# MANAGED_ACCOUNTS_ENABLED=true
# FEATURE_REGISTRATION_ENABLED=false
# MAIL_PROVIDER=disabled
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SECURE=false
AI_GATEWAY_ENABLED=false
FEATURE_AI_ENABLED=false
# Render Free has an ephemeral filesystem; persist the encrypted provider vault in PostgreSQL.
AI_VAULT_STORAGE=file
# AI_CREDENTIALS_MASTER_KEY must be a private 32-byte base64 value or 64 hex characters.
# INITIAL_ADMIN_* are temporary first-start values, removed from the running API process.
INITIAL_ADMIN_ENABLED=false
# If the safe startup log reports a catalog-only retry, set INITIAL_ADMIN_CATALOG_RETRY_ID
# to that existing administrator UUID temporarily; no password or new admin is needed.
MANAGED_ACCOUNTS_ENABLED=false
FEATURE_REGISTRATION_ENABLED=true
VIDEO_WORKER_ENABLED=false
BACKUP_ENABLED=false
SWAGGER_ENABLED=false
# For a backend running OUTSIDE Compose, also configure these privately:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# Or paste the managed internal Redis URL into the server's secret settings:
# REDIS_URL=redis://HOST:6379
