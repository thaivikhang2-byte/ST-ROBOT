# Copy values into a private .env or your hosting platform settings.
# For a NEW local setup, `node scripts/init-backend.cjs` generates distinct secrets.
NODE_ENV=development
POSTGRES_DB=strobot
POSTGRES_USER=strobot
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
MAIL_PROVIDER=file
MAIL_OUTBOX=/app/.mail-outbox
# Production requires NODE_ENV=production, explicit HTTPS frontend origin and SMTP.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SECURE=false
AI_GATEWAY_ENABLED=false
FEATURE_AI_ENABLED=false
VIDEO_WORKER_ENABLED=false
BACKUP_ENABLED=false
SWAGGER_ENABLED=false
# For a backend running OUTSIDE Compose, also configure these privately:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
