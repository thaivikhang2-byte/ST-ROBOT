    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.0",
    "jest": "^29.7.0",
    "prisma": "6.19.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "js-yaml": "4.3.2",
    "body-parser": "1.20.9",
    "multer": "2.5.0",
