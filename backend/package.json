{
  "name": "st-robot-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node scripts/prisma-portable.cjs generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "admin:bootstrap": "ts-node scripts/bootstrap-admin.ts",
    "db:content": "ts-node prisma/import-learning.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
